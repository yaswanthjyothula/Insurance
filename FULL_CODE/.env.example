# Copy to FULL_CODE/.env and fill in. Never commit the real file.

# Secret used to sign sign-in sessions. Use a long random value, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Left empty, a temporary key is used and sign-ins end when the server restarts.
SECRET_KEY=

# Gemini reads free-text scenarios in Scenario Studio. Left empty, a simple built-in reader is used.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=1024
LLM_REQUESTS_PER_MINUTE=10

# Optional: sign-in through Supabase, called from the server only. Left empty, local accounts are used.
SUPABASE_URL=
SUPABASE_KEY=

# Passwordless sign-in as a synthetic demo customer. Set to false anywhere real people sign in.
ENABLE_DEMO_LOGIN=true

# Where `python FULL_CODE/main.py` serves the API.
API_HOST=127.0.0.1
API_PORT=8000

# Browser origins allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where the problem pack's CSV/JSON files are (default: FULL_CODE/data) and where runtime data is written.
# LIFESURE_DATA_DIR=
# LIFESURE_STORE_DIR=
